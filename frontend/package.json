{
  "name": "data-explore-selfservice-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "verify:pivot": "esbuild scripts/verify-pivot.ts --bundle --platform=node --format=esm --outfile=.verify/pivot.mjs --alias:@=./src && node .verify/pivot.mjs",
    "verify:pivot-service": "esbuild scripts/verify-pivot-service.ts --bundle --platform=node --format=esm --outfile=.verify/pivot-service.mjs --alias:@=./src && node .verify/pivot-service.mjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
